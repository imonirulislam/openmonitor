{
  "name": "@openmonitor/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun build src/vercel.ts --outfile=api/index.js --target=node --format=esm",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:types": "tsgolint --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@openmonitor/auth": "workspace:*",
    "@openmonitor/clickhouse": "workspace:*",
    "@openmonitor/db": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "rrule": "^2.8.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@openmonitor/tsconfig": "workspace:*",
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3"
  }
}
