{
  "name": "@openmonitor/notifier",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "bun build src/vercel.ts --outfile=api/index.js --target=node --format=esm",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:types": "tsgolint --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@openmonitor/db": "workspace:*",
    "@openmonitor/notifications": "workspace:*",
    "dotenv": "^16.4.5",
    "hono": "^4.13.2",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@openmonitor/tsconfig": "workspace:*",
    "@types/node": "^20.16.0",
    "typescript": "^5.6.3"
  }
}
