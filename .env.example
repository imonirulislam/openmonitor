# --- Database ---
# Local Postgres from docker compose.
DATABASE_URL="postgres://openmonitor:openmonitor@localhost:5433/open_monitor"

# The Neon driver carries Postgres over a WebSocket, which plain Postgres can't
# terminate. Locally, point this at the wsproxy sidecar so dev runs the same
# driver path as production. Leave it unset against Neon.
NEON_WS_PROXY="localhost:5434"

# In production this is a Neon connection string. Use the POOLED endpoint — the
# host with "-pooler" in it — so serverless invocations don't each consume a
# direct connection:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Put the real value in .env, never here. This file is committed.

# --- Auth (apps/web) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-32-byte-random-secret"
AUTH_URL="http://localhost:5001"

# --- Optional SSO providers (uncomment when ready) ---
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_JUMPCLOUD_ISSUER="https://oauth.id.jumpcloud.com/"
# AUTH_JUMPCLOUD_ID=""
# AUTH_JUMPCLOUD_SECRET=""

# --- Internal API ---
# Public-facing URL of apps/api (used by status-page and admin web)
API_URL="http://localhost:5002"
# Operational endpoints (/v1/system/*) used by the admin "System status" page
PROBE_API_KEY="change-me-probe-key"
# Probe-location token. Identifies WHICH location a checker is, and the server
# derives the region from it — checkers no longer declare their own region.
# The seed stores a hash of this value; rotate by re-seeding or via the admin UI.
PROBE_TOKEN="omp_dev_local_change_me"

# --- Public status page ---
NEXT_PUBLIC_STATUS_TITLE="OpenMonitor"
NEXT_PUBLIC_STATUS_DESCRIPTION="Live status for your services"
NEXT_PUBLIC_API_URL="http://localhost:5002"

# --- Checker (Go) ---
CHECKER_DEFAULT_TIMEOUT_MS="10000"
# Optional: set to enable instant refresh on monitor changes via pg_notify.
# When set, the checker also subscribes to LISTEN monitor_changed and refreshes
# immediately on each notification. When unset, the checker still works and
# refreshes monitors on its periodic tick (CHECKER_REFRESH_INTERVAL).
# CHECKER_DATABASE_URL is intentionally aliased to DATABASE_URL so the same
# value can be reused locally; the Go binary only reads DATABASE_URL.

# --- Slack (default channel; per-channel webhooks live in DB) ---
# Optional fallback used when no notification channels are configured
SLACK_DEFAULT_WEBHOOK_URL=""
