{
  "name": "open-monitor",
  "private": true,
  "version": "0.1.0",
  "description": "Status page and incident management for your services",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20.11.0",
    "bun": ">=1.2.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check . && oxlint . && oxlint-tsgolint",
    "lint:fix": "biome check --write . && oxlint --fix .",
    "lint:types": "oxlint-tsgolint",
    "format": "biome format --write . && oxfmt .",
    "typecheck": "turbo run typecheck",
    "knip": "knip",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "db:generate": "bun run --filter @openmonitor/db generate",
    "db:migrate": "bun run --filter @openmonitor/db migrate",
    "db:seed": "bun run --filter @openmonitor/db seed",
    "db:studio": "bun run --filter @openmonitor/db studio",
    "gen": "turbo gen"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@turbo/gen": "1.13.3",
    "@types/node": "^20.16.0",
    "knip": "^5.30.0",
    "oxfmt": "0.20.0",
    "oxlint": "1.36.0",
    "oxlint-tsgolint": "^0.10.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  }
}
