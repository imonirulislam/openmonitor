{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Nothing compiles against this file — every app and package has its own
  // tsconfig and turbo runs tsc per package. It exists so that tools which
  // discover a tsconfig by walking up from the working directory find the
  // repo's settings instead of falling back to compiler defaults.
  // tsconfig.base.json is not a name tsc looks for on its own.
  //
  // `files: []` keeps it from claiming any sources.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "files": []
}
