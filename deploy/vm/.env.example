# Neon, pooled endpoint (the host with -pooler in it)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ClickHouse. Same values go in the Vercel projects' CLICKHOUSE_USER/PASSWORD,
# with CLICKHOUSE_URL pointing at this box.
# Public hostname for ClickHouse. Point an A record at this box; Caddy gets a
# certificate for it on first start. Used as CLICKHOUSE_URL on Vercel:
#   CLICKHOUSE_URL=https://clickhouse.openmonitor.app
CLICKHOUSE_HOSTNAME="clickhouse.openmonitor.app"
CLICKHOUSE_USER="openmonitor"
CLICKHOUSE_PASSWORD="generate-something-long"
RETENTION_RUN_DAYS="180"

# Public API, and this location's token from Settings → Probe locations
API_URL="https://api.openmonitor.app"
PROBE_TOKEN="omp_..."

SLACK_DEFAULT_WEBHOOK_URL=""
