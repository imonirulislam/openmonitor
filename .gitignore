dist/
build/
.next/
out/
.turbo/

# Go
apps/checker/bin/
apps/checker/checker
*.test
vendor/

# Env
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
bun-debug.log*

# Editor / OS
.DS_Store
.idea/
